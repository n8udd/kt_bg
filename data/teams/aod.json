{
  "key": "aod",
  "name": "Angels of Death",
  "subtitle": "Jan '26 errata · 35 physical loadouts",
  "intro": "1 leader from {Assault Intercessor Sgt, Intercessor Sgt, Space Marine Captain} + 5 from {Assault Intercessor Grenadier, Assault Intercessor Warrior, Eliminator Sniper, Heavy Intercessor Gunner, Intercessor Gunner (with aux grenade launcher), Intercessor Warrior}. Non-Warrior operatives may only be included once.",
  "footnotes_html": "",
  "faction_rules": [
    {
      "name": "Chapter Tactics",
      "text": "Select a primary and secondary Chapter Tactic. Multiple instances aren't cumulative. 1. Aggressive — melee weapons have Rending. 2. Dueller — normal successes can block crits (unless Brutal). 3. Resolute — ignore APL changes; not affected by Shock. 4. Stealthy — retain one additional cover save, or one as a crit. 5. Mobile — Fall Back for 1 less AP; Charge while in control range. 6. Hardy — defence 5+ are critical successes; first Normal Dmg 3+ in retaliation reduced by 1. 7. Sharpshooter — bolt weapons have Accurate 1 and Severe when not Charged/Fallen Back/Repositioned. 8. Siege Specialist — ranged weapons have Saturate; enemies can't assist in melee."
    },
    {
      "name": "Astartes",
      "text": "During each activation, can perform two Shoot or two Fight actions. For two Shoot actions, a bolt weapon must be selected for at least one; bolt sniper rifle or heavy bolter costs +1 AP for the second action if both use that weapon. Each friendly Angel of Death operative can counteract regardless of its order."
    }
  ],
  "strategy_ploys": [
    {"name": "Combat Doctrine", "text": "Select Devastator (shooting >6\"), Tactical (shooting within 6\"), or Assault (fighting/retaliating) — operatives in that situation gain Balanced on their weapons."},
    {"name": "And They Shall Know No Fear", "text": "Ignore changes to stats of friendly Angel of Death operatives from being injured, including their weapons' stats."},
    {"name": "Indomitus", "text": "Whenever an operative is shooting a friendly Angel of Death operative, if you roll two or more fails, discard one to retain another as a normal success."},
    {"name": "Adaptive Tactics", "text": "Change your secondary Chapter Tactic until the end of the turning point, then it reverts."}
  ],
  "firefight_ploys": [
    {"name": "Adjust Doctrine", "text": "During a friendly Angel of Death operative's activation, before or after an action: if Combat Doctrine was used this turning point, change the selected doctrine."},
    {"name": "Transhuman Physiology", "text": "When an operative is shooting a friendly Angel of Death operative, in the Roll Defence Dice step: retain one normal success as a critical success."},
    {"name": "Shock Assault", "text": "When a friendly Angel of Death operative performs Fight after Charging, at the start of Resolve Attack Dice: its melee weapon has Shock and the first strike inflicts +1 damage (max 7)."},
    {"name": "Wrath of Vengeance", "text": "When a friendly Angel of Death operative is counteracting: it can perform one additional 1AP action for free — both actions must be different."}
  ],
  "equipment": [
    {"name": "Purity Seals", "text": "Once per turning point when shooting, fighting, or retaliating: if you roll two or more fails, discard one to retain another as a normal success."},
    {"name": "Auspex", "text": "Once per turning point when performing the Shoot action: until end of activation, enemy operatives within 8\" of the bearer cannot be obscured."},
    {"name": "Chapter Reliquaries", "text": "You can use the Wrath of Vengeance firefight ploy for 0CP if the specified friendly operative has an Engage order."},
    {"name": "Tilting Shields", "text": "Once per turning point when fighting or retaliating: after your opponent rolls attack dice but before re-rolls, they cannot retain results below 6 as critical successes."}
  ],
  "max_shooting": 2,
  "max_melee": 1,
