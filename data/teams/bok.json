{
  "key": "bok",
  "name": "Blades of Khaine",
  "subtitle": "Oct '25 errata · 17 physical loadouts",
  "intro": "1 Exarch (Dire Avenger, Howling Banshee, or Striking Scorpion) + 7 Warriors freely chosen from the three Warrior types. Warriors are the only repeatable operatives.",
  "footnotes_html": "",
  "faction_rules": [
    {
      "name": "Aspect Techniques",
      "text": "Each Aspect (Dire Avenger / Howling Banshee / Striking Scorpion) has its own pool of techniques, usable only by operatives of that Aspect. No more than one per activation/counteraction, no more than once per turning point each (twice if all operatives share one Aspect keyword). Dire Avenger: The Slicing Hurricane, Death of a Thousand Blades, Vigilance of the Avenger, Unstinting Immovable, Raging Heat of the Dying Flame. Howling Banshee: The Woe, Rain of Tears, Acrobatic, Scream-That-Steals, Shriek-That-Kills. Striking Scorpion: Patient Stalk Sudden Blow, Strike and Fade, Scorpion's Eye, Merciless Strikes, One with the Gloom."
    }
  ],
  "strategy_ploys": [
    {"name": "Forewarned", "text": "Re-roll defence dice of one result vs a ready friendly."},
    {"name": "Ruthless Poise", "text": "Melee Ceaseless vs ready operatives."},
    {"name": "Khaine's Vengeance", "text": "Ranged Ceaseless vs expended operatives."},
    {"name": "Dance of Death", "text": "Swap two operatives' positions."}
  ],
  "firefight_ploys": [
    {"name": "Bladewind", "text": "Two Fight actions during activation."},
    {"name": "Starfall", "text": "Two Shoot actions during activation."},
    {"name": "Fading Light", "text": "Fall Back for 1 less AP."},
    {"name": "Contempt", "text": "Opponent cannot re-roll attack dice while retaliating or shooting this operative."}
  ],
  "equipment": [
    {"name": "Rune of Prophecy", "text": "±D3 to initiative roll-off."},
    {"name": "Rune of Shielding", "text": "Once per battle ignore Normal Dmg."},
    {"name": "Rune of Foresight", "text": "D3-turn +1 CP from Strategy phase."},
    {"name": "Wraithbone Talisman", "text": "Once per turning point convert two fails to one normal success."}
  ],
  "max_shooting": 2,
  "max_melee": 2,
